# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public
# Example (local):  postgresql://postgres:yourpassword@localhost:5432/car_dealership
# Example (Docker): postgresql://postgres:yourpassword@localhost:5432/car_dealership
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/car_dealership?schema=public"

# ─── JWT (used in a later step) ───────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
