// ─── Prisma Schema ────────────────────────────────────────────────────────────
// Car Dealership Inventory System
// Database: PostgreSQL
// ORM: Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

/// Roles available to users of the system.
/// USER  → standard customer/browser
/// ADMIN → full management access (add, update, delete vehicles, restock)
enum Role {
  USER
  ADMIN
}

// ─── Models ───────────────────────────────────────────────────────────────────

/// Represents a registered user of the system.
model User {
  /// Primary key — UUID generated by the database
  id        String   @id @default(uuid())

  /// Full name of the user
  name      String

  /// Unique email address used for authentication
  email     String   @unique

  /// Hashed password (bcrypt) — never stored as plain text
  password  String

  /// Role-based access control — defaults to USER
  role      Role     @default(USER)

  /// Automatically set when the record is created
  createdAt DateTime @default(now())

  /// Automatically updated whenever the record is modified
  updatedAt DateTime @updatedAt

  @@map("users")
}

/// Represents a vehicle in the dealership inventory.
model Vehicle {
  /// Primary key — UUID generated by the database
  id        String   @id @default(uuid())

  /// Vehicle manufacturer (e.g. Toyota, Ford)
  make      String

  /// Vehicle model name (e.g. Camry, Mustang)
  model     String

  /// Vehicle category (e.g. Sedan, SUV, Truck, Electric)
  category  String

  /// Sale price in cents stored as an integer to avoid floating-point issues.
  /// Example: $25,000.00 is stored as 2500000
  /// Use Decimal for exact monetary representation.
  price     Decimal  @db.Decimal(12, 2)

  /// Number of units currently available in stock (cannot be negative)
  quantity  Int      @default(0)

  /// Automatically set when the record is created
  createdAt DateTime @default(now())

  /// Automatically updated whenever the record is modified
  updatedAt DateTime @updatedAt

  @@map("vehicles")
}
