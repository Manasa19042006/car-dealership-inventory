# ─── Test Environment ─────────────────────────────────────────────────────────
# This file is used ONLY when running Jest tests.
# It points to a SEPARATE test database so tests never touch your dev data.
# This file is safe to commit (no real secrets — use the same creds, different DB).

PORT=5001
NODE_ENV=test

# JWT Secret
JWT_SECRET=test_jwt_secret_for_testing_only
JWT_EXPIRES_IN=1h

# Test database — separate from the development database
# Uses the same PostgreSQL instance but a different database name
DATABASE_URL="postgresql://postgres:23Wh1a1234%40@localhost:5432/car_dealership_test?schema=public"
